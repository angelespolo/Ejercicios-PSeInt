Algoritmo CLASE11AGOSTO
	// Realice un programa que se le solicite al usuario el ingreso de dos valores numericos, elevar el numero a 
	//potencia y mostrar el resultado
	
	Definir numeroBase Como Entero
	Definir numeroExponente Como Entero
	Definir resultado Como Entero
	
	Escribir 'ingrese el primer valor' 
	Leer numeroBase 	
	Escribir 'inrese el segundo valor'
	Leer numeroExponente
	resultado = numeroBase^ numeroExponente
	
	Escribir 'El resultado de la potencia es:' , resultado
	
	
	
FinAlgoritmo
